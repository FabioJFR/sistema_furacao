[Unit]
Description=Sistema Furacao - Backup operacional de base de dados e media
After=network.target postgresql.service

[Service]
Type=oneshot
User=ubuntu
Group=www-data
WorkingDirectory=/var/www/sistema_furacao
Environment="APP_DIR=/var/www/sistema_furacao"
Environment="DRY_RUN=0"
ExecStart=/usr/bin/env bash /var/www/sistema_furacao/deploy/backup_operacional.sh
