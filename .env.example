# ==============================
# Django (Produção)
# ==============================
DJANGO_SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET_KEY
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=sistemafuracao.pt,www.sistemafuracao.pt,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://sistemafuracao.pt,https://www.sistemafuracao.pt

# Segurança
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
DJANGO_USE_X_FORWARDED_PROTO=True
DJANGO_USE_X_FORWARDED_HOST=True

# Logs
DJANGO_LOG_DIR=/var/log/sistema_furacao

# URL pública da plataforma
SITE_BASE_URL=https://www.sistemafuracao.pt

# ==============================
# Base de dados (PostgreSQL)
# ==============================
POSTGRES_DB=sistema_furacao_nova
POSTGRES_USER=sistema_user
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ==============================
# Email (SMTP real)
# ==============================
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=CHANGE_ME_EMAIL@gmail.com
DJANGO_EMAIL_HOST_PASSWORD=CHANGE_ME_APP_PASSWORD
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_USE_SSL=False
DJANGO_DEFAULT_FROM_EMAIL=noreply@sistemafuracao.pt

# Destino das sugestões da plataforma (pode ter vários emails separados por vírgula)
DJANGO_SUGESTOES_EMAIL_DESTINO=sistemafuracao@gmail.com

# ==============================
# PayPal (opcional)
# ==============================
PAYPAL_ENABLED=False
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=CHANGE_ME_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=CHANGE_ME_PAYPAL_CLIENT_SECRET
PAYPAL_WEBHOOK_ID=CHANGE_ME_PAYPAL_WEBHOOK_ID

# ==============================
# Upload Security (ficheiros/imagens)
# ==============================
# Ativar scan antivírus (necessita clamscan instalado no servidor)
UPLOAD_VIRUS_SCAN_ENABLED=False
UPLOAD_VIRUS_SCAN_COMMAND=clamscan
UPLOAD_VIRUS_SCAN_TIMEOUT_SECONDS=15

# Limites de tamanho (MB)
UPLOAD_MAX_IMAGE_MB=8
UPLOAD_MAX_FILE_MB=25

# Sanitização/compressão automática de imagens
UPLOAD_IMAGE_SANITIZE_ENABLED=True
UPLOAD_IMAGE_MAX_EDGE_PX=2560
UPLOAD_IMAGE_JPEG_QUALITY=82
UPLOAD_IMAGE_OPTIMIZE=True

# Extensões permitidas/bloqueadas
UPLOAD_ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.webp,.gif
UPLOAD_ALLOWED_FILE_EXTENSIONS=.pdf,.txt,.csv,.json,.geojson,.las,.obj,.dxf,.zip,.doc,.docx,.xls,.xlsx
UPLOAD_BLOCKED_EXTENSIONS=.exe,.dll,.bat,.cmd,.com,.scr,.msi,.ps1,.sh,.php,.phtml,.js,.jar,.apk,.bin
